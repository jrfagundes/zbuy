{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "@zbuy/api", "dev"],
      "port": 3001
    },
    {
      "name": "web",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "@zbuy/web", "dev"],
      "port": 3000
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "corepack",
      "runtimeArgs": ["pnpm", "--filter", "@zbuy/mobile", "exec", "expo", "start", "--web", "--port", "8081"],
      "port": 8081
    }
  ]
}
